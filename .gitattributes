* text=auto eol=lf

*.cs        text diff=csharp
*.md        text
*.json      text
*.yml       text
*.css       text
*.mjs       text
*.ps1       text eol=crlf
*.cmd       text eol=crlf

# Unity serialized assets
*.unity     text
*.asset     text
*.mat       text
*.meta      text
*.prefab    text

*.png       binary
*.zip       binary
*.dll       binary
*.exe       binary

# Demo06 frozen evidence and original verdicts use byte-level SHA-256 receipts.
# Preserve their actual bytes instead of applying repository text normalization.
/Evidence/Demo06/** -text
/reviewer-agents/*/demo06*.md -text
